# BrandGuard Environment Configuration
# Copy this file to .env or server/.env and fill in your values.

# Server listening port (default: 5000)
PORT=5000

# Runtime environment ('development' | 'production')
NODE_ENV=development

# Google Gemini API Key (required for AI compliance review, document import, and clarification)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name (default: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Cryptographic HMAC-SHA256 signing secret for Compliance Certificates
# Required in production (NODE_ENV=production). In development, a fallback is used.
CERT_SECRET=your_long_random_secret_here
